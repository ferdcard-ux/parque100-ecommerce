# Ejemplo de variables de entorno del backend.
# Copia este archivo a `.env` y ajusta los valores.
# El servidor las carga automaticamente con process.loadEnvFile().

# Servidor
PORT=3001

# Base de datos MySQL: cuenta de la app con privilegios minimos (no root).
#   CREATE USER 'p100_app'@'localhost' IDENTIFIED BY '<aleatoria>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON parque100.* TO 'p100_app'@'localhost';
# Migraciones y restauraciones usan DB_ADMIN_USER/DB_ADMIN_PASSWORD definidos
# en la terminal, nunca en este archivo.
DB_HOST=localhost
DB_PORT=3306
DB_USER=p100_app
DB_PASSWORD=
DB_NAME=parque100

# Private site-entry identity database (configured locally with npm run access:provision)
SITE_ACCESS_DB_USER=
SITE_ACCESS_DB_PASSWORD=

# Autenticacion
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta
JWT_EXPIRES_IN=8h

# CORS: origenes del frontend autorizados (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
